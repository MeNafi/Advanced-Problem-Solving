generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Movie {
  id          String   @id @default(cuid())
  title       String   @unique
  releaseYear Int
  runtime     Int
  watched     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Movies this movie depends on (watch these first)
  prerequisites MoviePrerequisite[] @relation("MovieToPrerequisites")
  // Movies that list this movie as a prerequisite
  dependents    MoviePrerequisite[] @relation("PrerequisiteToMovies")
}

// Explicit join table = self-referencing many-to-many on Movie
model MoviePrerequisite {
  movieId        String
  prerequisiteId String

  movie        Movie @relation("MovieToPrerequisites", fields: [movieId], references: [id], onDelete: Cascade)
  prerequisite Movie @relation("PrerequisiteToMovies", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([movieId, prerequisiteId])
  @@index([prerequisiteId])
}

model Cinema {
  id          String   @id @default(cuid())
  name        String   @unique
  bundleSizes Int[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
